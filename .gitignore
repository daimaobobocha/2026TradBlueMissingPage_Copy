# Generated debug metadata
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Automatically generated Rider integration
/[Aa]ssets/Plugins/Editor/JetBrains*

# Local logs, temporary files and crash reports
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
sysinfo.txt
.dirstamp

# Operating system files
.DS_Store
.DS_Store?
._*
Thumbs.db
Thumbs.db.meta
Desktop.ini
Desktop.ini.meta

# These two FBX files exceed GitHub's regular-file size limit.
# Ignoring them keeps local copies, but excludes them from future clones.
# If the game needs them, remove these four rules and use Git LFS instead.
/[Aa]ssets/TutorialInfo/FX/Models/DeadCity 1.fbx
/[Aa]ssets/TutorialInfo/FX/Models/DeadCity 1.fbx.meta
/[Aa]ssets/TutorialInfo/FX/Models/DeadCity.fbx
