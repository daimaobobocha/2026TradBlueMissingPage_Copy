# Unity project ignore rules.
# Place beside Assets/, Packages/ and ProjectSettings/.
# Keep project assets, source files and their .meta files in Git.

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/.utmp/

# Build output and captures
/[Bb]uild/
/[Bb]uilds/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# IDE caches and generated C# project files
.vs/
.idea/
.consulo/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
